PORT=3001
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
MONGODB_URI=mongodb://localhost:27017/billing_system
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3002
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Firebase Admin SDK (from Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# WhatsApp Business API (optional — order confirmations sent via WABA if configured)
WABA_TOKEN=
WABA_PHONE_NUMBER_ID=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash


# Razorpay webhook secret (Dashboard > Webhooks). Webhooks are rejected when unset.
RAZORPAY_WEBHOOK_SECRET=

# ── Auth ──────────────────────────────────────────────────────────────
# false: missing/invalid tokens are logged as [AUTH] but allowed (migration period)
# true:  admin routes need a Firebase ID token; customer routes need a session token
AUTH_ENFORCE=false
# Firebase Auth emails allowed to use the admin API (or set the `admin: true` custom claim)
ADMIN_EMAILS=owner@example.com
# Signs customer session tokens returned by /auth/login and /auth/register
CUSTOMER_TOKEN_SECRET=generate-with-openssl-rand-base64-32
# Optional per-IP limits (requests/minute)
AUTH_RATE_LIMIT_PER_MIN=60
AI_RATE_LIMIT_PER_MIN=10
